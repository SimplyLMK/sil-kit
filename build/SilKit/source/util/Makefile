	cd /d D:\SIL\sil-kit\build && $(MAKE) $(MAKESILENT) -f SilKit\source\util\CMakeFiles\O_SilKit_Util_Uuid.dir\build.make SilKit/source/util/CMakeFiles/O_SilKit_Util_Uuid.dir/Uuid.cpp.s
.PHONY : Uuid.cpp.s

