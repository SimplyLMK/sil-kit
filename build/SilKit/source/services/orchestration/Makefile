	cd /d D:\SIL\sil-kit\build && $(MAKE) $(MAKESILENT) -f SilKit\source\services\orchestration\CMakeFiles\O_SilKit_Services_Orchestration.dir\build.make SilKit/source/services/orchestration/CMakeFiles/O_SilKit_Services_Orchestration.dir/WatchDog.cpp.i
.PHONY : WatchDog.cpp.i

WatchDog.s: WatchDog.cpp.s
.PHONY : WatchDog.s

# target to generate assembly for a file
WatchDog.cpp.s:
	cd /d D:\SIL\sil-kit\build && $(MAKE) $(MAKESILENT) -f SilKit\source\services\orchestration\CMakeFiles\O_SilKit_Services_Orchestration.dir\build.make SilKit/source/services/orchestration/CMakeFiles/O_SilKit_Services_Orchestration.dir/WatchDog.cpp.s
.PHONY : WatchDog.cpp.s

